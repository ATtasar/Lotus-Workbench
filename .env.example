# Default development preserves the original browser-only mode.
VITE_DATA_MODE=local
VITE_API_BASE_URL=/api
VITE_APP_TARGET=web
# For local API integration: set VITE_DATA_MODE=cloud, start backend, keep /api.
# Windows/Docker production builds use build:production and cloud mode automatically.
# Future Android builds must use a public absolute HTTPS URL and VITE_APP_TARGET=android.
# Never place passwords, database URLs or cloud keys in VITE_* variables.
