{
  "name": "lotus-workbench",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build:local": "node scripts/build-local.mjs",
    "local:install": "node scripts/local-windows.mjs install",
    "local:start": "node scripts/local-windows.mjs start",
    "local:stop": "node scripts/local-windows.mjs stop",
    "local:backup": "node scripts/local-windows.mjs backup",
    "local:restore": "node scripts/local-windows.mjs restore",
    "test:local": "vitest run tests/local-storage.test.ts tests/desktop-storage.test.ts",
    "test:desktop:ui": "node tests/desktop-local-e2e.mjs",
    "test:local:launcher": "node tests/desktop-launcher.mjs",
    "test:local:ui": "node tests/desktop-local-e2e.mjs",
    "dev": "node scripts/local-windows.mjs start",
    "build": "node scripts/build-local.mjs",
    "build:production": "node scripts/build-production.mjs",
    "build:backend": "npm --prefix backend run build",
    "test:backend": "npm --prefix backend test",
    "test:cloud": "npm run build:backend && playwright test --config playwright.cloud.config.ts",
    "typecheck": "tsc -p tsconfig.local.json",
    "test": "vitest run",
    "test:e2e": "node tests/desktop-local-e2e.mjs",
    "test:e2e:legacy-react": "playwright test",
    "preview": "node scripts/local-windows.mjs start",
    "format": "prettier --write src tests *.ts *.json README.md",
    "dev:legacy-react": "vite --host 127.0.0.1",
    "build:legacy-react": "tsc -b && vite build",
    "preview:legacy-react": "vite preview --host 127.0.0.1",
    "start": "node scripts/local-windows.mjs start"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "prettier": "^3.9.10",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.0"
  },
  "overrides": {
    "rollup": "4.64.9"
  },
  "description": "Windows 本地运行的电脑端接稿工作台",
  "engines": {
    "node": "24.x"
  }
}
