# Docker/Linux example. Keep the real file in deploy/private/compose.env.
# Use random hexadecimal database passwords so the connection URL needs no escaping.
PG_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_HEX
DB_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_HEX
ADMIN_USERNAME=creator
ADMIN_PASSWORD=REPLACE_WITH_AT_LEAST_12_CHARACTERS
SITE_ADDRESS=your-domain.example
PUBLIC_ORIGIN=https://your-domain.example
CORS_ORIGINS=
